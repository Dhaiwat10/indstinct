NEAR_AI_API_KEY=
NEAR_AI_BASE_URL=https://cloud-api.near.ai/v1
MODEL_PRIMARY=deepseek-ai/DeepSeek-V4.1-Flash-1017
MODEL_VISION=Qwen/Qwen3.8-27B
MODEL_HEAVY=deepseek-ai/DeepSeek-V4.1-Flash-1017
MODEL_EXTRACT=Qwen/Qwen3.6-35B-A3B-FP8
MODEL_WHISPER=openai/whisper-large-v3
TAVILY_API_KEY=
# Gmail (optional). Google Cloud → OAuth client (Web application) with ${PUBLIC_URL}/gmail/callback as a redirect URI,
# and the Gmail API enabled. Leave empty to run without /gmail.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Where users' browsers reach the OAuth callback; defaults to http://localhost:${PORT}. Must be https on a server.
PUBLIC_URL=
PORT=3000
# Docker only: the hostname Caddy gets a certificate for (PUBLIC_URL without https://)
DOMAIN=
# comma-separated, country code, no +; empty = allow all
ALLOWED_NUMBERS=
# set to the bot SIM's number (e.g. 91XXXXXXXXXX) to pair with an 8-char code instead of a QR
WA_PAIR_NUMBER=
DEFAULT_TZ=Asia/Kolkata
DATA_DIR=./data
LOG_LEVEL=info
